{
  "name": "canopy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm db:migrate:local && vite",
    "build": "vite build",
    "test": "vitest run",
    "start": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "CI=true WRANGLER_SEND_METRICS=false wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:preview": "vite build && vite preview",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.16.0",
    "nanoid": "^6.0.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vite": "^8.3.2",
    "vitest": "^2.1.9",
    "wrangler": "^4.147.0"
  }
}
