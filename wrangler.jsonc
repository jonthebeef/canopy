{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opportunity-solution-tree-app",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "opportunity-solution-tree-app"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opportunity-tree",
      "database_id": "c1534672-db8c-4b0b-a31b-4618fb228292",
      "preview_database_id": "16b241e8-fbae-4f90-937e-558adcfc538e",
      "migrations_dir": "drizzle"
    }
  ],
  "previews": {
    "vars": {
      "CANOPY_PREVIEW": "true"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "opportunity-solution-tree-preview",
        "database_id": "16b241e8-fbae-4f90-937e-558adcfc538e",
        "migrations_dir": "drizzle"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
